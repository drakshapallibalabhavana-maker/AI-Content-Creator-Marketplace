# Supabase Configuration
# Replace these with your actual Supabase project URL and anon public key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Server-only administrative key (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: AI Brief Builder LLM Provider API Key (server-side only)
LLM_API_KEY=your-llm-api-key-here
LLM_PROVIDER=openai # or gemini

# Application base URL (used for metadata and absolute links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
